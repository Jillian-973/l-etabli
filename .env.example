# ------------------------------------------------------------------
#  Calendly — configuration serveur (JAMAIS exposée au frontend)
# ------------------------------------------------------------------
# Copiez ce fichier en .env (ignoré par git) et renseignez les valeurs.
# Voir docs/calendly.md pour la procédure complète.

# Personal Access Token Calendly (compte de L'Établi).
# Obtenu sur : https://calendly.com/integrations/api_webhooks
# SECRET — reste strictement côté serveur.
CALENDLY_ACCESS_TOKEN=

# URI API (≠ URL publique) de l'Event Type "Réparation confiée".
# Récupérable via GET https://api.calendly.com/event_types
CALENDLY_REPAIR_EVENT_TYPE_URI=

# URI API de l'Event Type "Atelier participatif".
# Laisser vide tant que l'atelier n'est pas activé (l'API renverra 501).
CALENDLY_WORKSHOP_EVENT_TYPE_URI=
